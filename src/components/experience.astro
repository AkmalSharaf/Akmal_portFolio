---
const roles = [
  {
    period: "March 2026 – Present",
    title: "Full Stack Developer Intern",
    company: "SLT Sri Lanka",
    summary:
      "Contributing to application development, feature implementation, testing, debugging, and technical documentation in an Agile team.",
    highlights: [
      "Build and support frontend and backend functionality across live applications.",
      "Investigate issues, identify root causes, and help ship reliable fixes.",
      "Run structured testing and validation against defined requirements.",
      "Document issues, configurations, and resolutions while managing multiple technical tasks.",
    ],
  },
  {
    period: "2024 – 2026",
    title: "Process Associate",
    company: "HCL Tech",
    summary:
      "Supported customers and exam operations in a high-volume environment, building communication, documentation, and problem-solving skills.",
    highlights: [
      "Guided customers through structured issue-resolution processes.",
      "Monitored Pearson VUE examination sessions according to security procedures.",
      "Identified irregularities, escalated cases, and kept accurate records.",
      "Collaborated with internal teams to keep workflows efficient.",
    ],
  },
];

const education = [
  {
    period: "2022 – 2024",
    title: "BSc (Hons) in Computer Science",
    place: "University of Bedfordshire, United Kingdom",
    note: "First Class Honours",
    areas: [
      "Programming and Software Engineering",
      "Data Structures and Algorithms",
      "Distributed Service Architectures",
      "Computer Security",
      "Database and Application Development",
    ],
  },
  {
    period: "Higher Diploma",
    title: "Higher Diploma in IT",
    place: "Sri Lanka Institute of Information Technology (SLIIT), Colombo",
    note: "Foundation in software and systems",
    areas: [
      "Object-Oriented Programming",
      "Web Application Development",
      "Data Structures and Algorithms",
      "Computer Networks",
      "Computer Security",
    ],
  },
];
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Career path</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Experience</h3>

    <div class="space-y-6">
      {
        roles.map((role) => (
          <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
              <div>
                <h4 class="text-2xl font-semibold">{role.title}</h4>
                <p class="text-[var(--sec)] mt-1">{role.company}</p>
              </div>
              <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                {role.period}
              </span>
            </div>
            <p class="text-[var(--white-icon)] mb-4">{role.summary}</p>
            <ul class="space-y-2 text-sm text-[var(--white-icon)]">
              {role.highlights.map((item) => (
                <li class="flex gap-3">
                  <span class="text-[var(--sec)] mt-1">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-14">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Academic background</h2>
      <h3 class="text-4xl md:text-5xl font-medium mb-8">Education</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          education.map((item) => (
            <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
              <span class="text-sm text-[var(--white-icon)]">{item.period}</span>
              <h4 class="text-xl font-semibold mt-2">{item.title}</h4>
              <p class="text-[var(--sec)] mt-1">{item.place}</p>
              <p class="text-sm text-[var(--white)] mt-3">{item.note}</p>
              <ul class="mt-4 space-y-1 text-sm text-[var(--white-icon)]">
                {item.areas.map((area) => (
                  <li>{area}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
          <span class="text-sm text-[var(--white-icon)]">English Proficiency</span>
          <h4 class="text-xl font-semibold mt-2">IELTS Academic</h4>
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="rounded-lg border border-[var(--white-icon-tr)] p-3 text-center">
              <p class="text-2xl font-bold text-[var(--sec)]">8.0</p>
              <p class="text-xs text-[var(--white-icon)] mt-1">Listening</p>
            </div>
            <div class="rounded-lg border border-[var(--white-icon-tr)] p-3 text-center">
              <p class="text-2xl font-bold text-[var(--sec)]">6.5</p>
              <p class="text-xs text-[var(--white-icon)] mt-1">Reading</p>
            </div>
            <div class="rounded-lg border border-[var(--white-icon-tr)] p-3 text-center">
              <p class="text-2xl font-bold text-[var(--sec)]">6.5</p>
              <p class="text-xs text-[var(--white-icon)] mt-1">Writing</p>
            </div>
            <div class="rounded-lg border border-[var(--white-icon-tr)] p-3 text-center">
              <p class="text-2xl font-bold text-[var(--sec)]">6.0</p>
              <p class="text-xs text-[var(--white-icon)] mt-1">Speaking</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
