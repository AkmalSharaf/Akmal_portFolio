---
import "@fontsource-variable/montserrat";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="MMM. Akmal Sharaf — Graduate Python Engineer and Backend Developer. First Class Computer Science graduate with experience in full-stack development, NLP, and data processing."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://darkminimal.vercel.app/" />

    <meta
      property="og:title"
      content="Akmal Sharaf | Graduate Python Engineer"
    />
    <meta
      property="og:description"
      content="Portfolio of MMM. Akmal Sharaf — Backend Developer and Graduate Python Engineer focusing on scalable backend systems, NLP, and recommendation systems."
    />
    <meta property="og:url" content="https://darkminimal.vercel.app" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Your Name Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "MMM. Akmal Sharaf",
        "alternateName": "Akmal Sharaf",
        "url": "https://darkminimal.vercel.app",
        "sameAs": [
          "https://github.com/AkmalSharaf",
          "https://linkedin.com/in/akmal-sharaf-942575234/"
        ],
        "jobTitle": "Graduate Python Engineer",
        "description": "Graduate Python Engineer and Backend Developer with experience in NLP, data processing, and full-stack development."
      }
    </script>
  </head>
  <body class="bg-[var(--background)] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --component-bg: #141414;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --container: #1a1a1a;
    --line: #2a2a2a;
    --pink: #a476ff;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  [data-theme="light"] {
    --background: #ffffff;
    --component-bg: #f5f5f5;
    --sec: #a476ff;
    --white: #1a1a1a;
    --white-icon: #66666698;
    --white-icon-tr: #00000010;
    --container: #e8e8e8;
    --line: #d0d0d0;
    --pink: #a476ff;
  }

  [data-theme="light"] ::-webkit-scrollbar-track {
    background: var(--container);
  }

  [data-theme="light"] ::-webkit-scrollbar-thumb {
    background: var(--background);
  }

  [data-theme="light"] ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }
</style>